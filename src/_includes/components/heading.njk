{% from "components/caret.njk" import caret %}

{# Page or article title, optionally linked. The caret only shows on the article page, where the title is typed #}
{% macro heading(text, url, id) %}
<h1 {% if id %}id="{{ id }}"{% endif %} class="mb-3 mt-0 max-w-[800px] break-words font-mono text-[26px] font-semibold leading-[1.2] tracking-[-0.05em] text-ink md:text-[clamp(28px,3.6vw,36px)]">
  {% if url %}
    <a href="{{ url }}" class="hover:text-accent"><span data-text>{{ text }}</span></a>
  {% else %}
    <span data-text>{{ text }}</span>
  {% endif %}
  {% if id %}{{ caret() }}{% endif %}
</h1>
{% endmacro %}
