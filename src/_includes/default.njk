<!doctype html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <title>{{ title }} - Pixelastic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/atom.xml">
    {% if docsearchExclude %}<meta name="docsearch:exclude" content="true">{% endif %}
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col md:flex-row">
      <aside class="border-b border-gray-200 p-4 md:w-56 md:shrink-0 md:border-b-0 md:border-r md:p-6">
        <a href="/" class="block text-2xl font-bold">Pixelastic</a>
        <nav class="mt-3 flex gap-4 md:flex-col md:gap-2">
          <a href="/" class="hover:underline">Home</a>
          <a href="/about/" class="hover:underline">About</a>
          <a href="/archive/" class="hover:underline">Archive</a>
        </nav>
        <div id="search" class="mt-4"></div>
      </aside>
      <main class="min-w-0 flex-1 p-4 md:p-8">
        {{ content | safe }}
      </main>
    </div>
  </body>
</html>
