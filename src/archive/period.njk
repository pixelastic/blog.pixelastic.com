---
layout: default.njk
pagination:
  data: collections.archiveList
  size: 1
  alias: period
permalink: "{{ period.url }}"
eleventyComputed:
  title: "{{ period.title }}"
docsearchExclude: true
---
<h1 class="mb-4 text-3xl font-bold">{{ period.title }}</h1>
<ul class="list-disc space-y-1 pl-6">
  {% for post in period.posts %}
    <li><a class="text-blue-700 hover:underline" href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
