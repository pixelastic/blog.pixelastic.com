---
layout: default.njk
pagination:
  data: collections.archiveList
  size: 1
  alias: period
permalink: "{{ period.url }}"
eleventyComputed:
  title: "{{ period.title }}"
docsearchExclude: true
---
<h1>{{ period.title }}</h1>
<ul>
  {% for post in period.posts %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
