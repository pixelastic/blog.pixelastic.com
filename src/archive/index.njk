<div class="simple-page">
<h1 class="article-title">Archive</h1>
<ul class="simple-list">
  {% for period in collections.archiveList %}
    {% if period.level == 'year' %}
      <li><a href="{{ period.url }}">{{ period.year }}</a></li>
    {% endif %}
  {% endfor %}
</ul>
</div>
