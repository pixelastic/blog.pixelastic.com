---
layout: list.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag.slug }}/
eleventyComputed:
  title: "#{{ tag.name }}"
docsearchExclude: true
---
{% from "components/list.njk" import item %}
{% for post in tag.posts %}
  {{ item(post.url, post.data.title) }}
{% endfor %}
