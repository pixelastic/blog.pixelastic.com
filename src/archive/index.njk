---
layout: default.njk
title: Archive
permalink: /archive/
docsearchExclude: true
---
<h1 class="mb-4 text-3xl font-bold">Archive</h1>
<ul class="list-disc space-y-1 pl-6">
  {% for period in collections.archiveList %}
    {% if period.level == 'year' %}
      <li><a class="text-blue-700 hover:underline" href="{{ period.url }}">{{ period.year }}</a></li>
    {% endif %}
  {% endfor %}
</ul>
