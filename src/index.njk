---
layout: default.njk
title: Home
pagination:
  data: collections.postList
  size: 5
  alias: pagePosts
permalink: "{{ '/' if pagination.pageNumber == 0 else '/page' + (pagination.pageNumber + 1) + '/' }}"
---
{% from "components/article.njk" import article %}
<section class="divide-y divide-line border-b border-line">
  {% for post in pagePosts %}
    {{ article(post.data.title, post.date, post.data.tags, post.content | safe, post.url) }}
  {% endfor %}
</section>

<nav class="mx-auto flex max-w-[800px] items-center justify-between pb-20 pt-[30px] font-mono text-[11px] text-muted" aria-label="Pagination">
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="text-accent hover:text-accent-bright">&larr; Older</a>
  {% else %}
    <span class="text-line">&larr; Older</span>
  {% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="text-accent hover:text-accent-bright">Newer &rarr;</a>
  {% else %}
    <span class="text-line">Newer &rarr;</span>
  {% endif %}
</nav>
