{% from "components/heading.njk" import heading %}
{% from "components/prose.njk" import prose %}

{# Full article: title, date, content and tags. Used by the home feed and the dedicated page #}
{% macro article(title, date, tags, content, url, titleId) %}
<article class="py-[48px] md:py-[60px]">
  {{ heading(title, url, titleId) }}
  <div class="mb-8 font-mono text-[11px] text-date">
    <time datetime="{{ date.toISOString() | truncate(10, true, '') }}">{{ date.toISOString() | truncate(10, true, '') }}</time>
  </div>
  {{ prose(content) }}
  <div class="mt-[38px] flex flex-wrap gap-2">
    {% for tag in tags %}
      <a href="/tags/{{ tag | tagSlug }}/" class="border border-tag-line bg-tag-bg px-2 py-[5px] font-mono text-[11px] text-tag hover:border-tag hover:text-tag">#{{ tag | trim }}</a>
    {% endfor %}
  </div>
</article>
{% endmacro %}
