---
layout: default.njk
title: Home
pagination:
  data: collections.postList
  size: 5
  alias: pagePosts
permalink: "{{ '/' if pagination.pageNumber == 0 else '/page' + (pagination.pageNumber + 1) + '/' }}"
---
<div class="space-y-12">
  {% for post in pagePosts %}
    <article>
      <h1 class="text-3xl font-bold">
        <a href="{{ post.url }}" class="hover:underline">{{ post.data.title }}</a>
      </h1>
      <time class="mb-4 block text-sm text-gray-500" datetime="{{ post.date.toISOString() | truncate(10, true, '') }}">{{ post.date.toISOString() | truncate(10, true, '') }}</time>
      <div class="prose max-w-3xl break-words">
        {{ post.content | safe }}
      </div>
      <p class="mt-4 text-sm text-gray-600">
        {% for tag in post.data.tags %}
          <a href="/tags/{{ tag | tagSlug }}/" class="mr-1 text-blue-700 hover:underline">#{{ tag }}</a>
        {% endfor %}
      </p>
    </article>
  {% endfor %}
</div>

<nav class="mt-12 flex max-w-3xl justify-between border-t border-gray-200 pt-4">
  {% if pagination.href.next %}
    <a class="text-blue-700 hover:underline" href="{{ pagination.href.next }}">Older</a>
  {% else %}
    <span class="text-gray-400">Older</span>
  {% endif %}
  {% if pagination.href.previous %}
    <a class="text-blue-700 hover:underline" href="{{ pagination.href.previous }}">Newer</a>
  {% else %}
    <span class="text-gray-400">Newer</span>
  {% endif %}
</nav>
