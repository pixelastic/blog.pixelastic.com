<!doctype html>
<html lang="en-us" class="scroll-smooth bg-paper [color-scheme:dark] motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8">
    <title>{{ title }} - Pixelastic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#080b09">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/vendor/docsearch.css">
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/atom.xml">
    {% if docsearchExclude %}<meta name="docsearch:exclude" content="true">{% endif %}
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <div class="mx-auto max-w-[1100px] px-[22px] md:px-[42px]">
      {% include "components/header.njk" %}
      {{ content | safe }}
      {% include "components/footer.njk" %}
    </div>
    <script src="/vendor/docsearch.js"></script>
    <script>
      docsearch({
        container: '#search',
        appId: '{{ site.docsearch.appId }}',
        apiKey: '{{ site.docsearch.apiKey }}',
        indices: ['{{ site.docsearch.indexName }}'],
      });
    </script>
  </body>
</html>
