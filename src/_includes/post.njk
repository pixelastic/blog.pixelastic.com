---
layout: default.njk
---
{% from "components/article.njk" import article %}
{{ article(title, page.date, tags, content | safe, titleId="article-title") }}

<script>
  // Type the title letter by letter; the full title stays in the HTML for no-JS and crawlers
  (() => {
    const title = document.getElementById("article-title");
    const label = title.querySelector("[data-text]");
    const caret = title.querySelector("[data-caret]");
    const text = label.textContent.trim();
    const typed = document.createElement("span");
    const untyped = document.createElement("span");
    untyped.className = "invisible";
    untyped.textContent = text;
    label.replaceChildren(typed, caret, untyped);
    let index = 0;
    const type = () => {
      index += 1;
      typed.textContent = text.slice(0, index);
      untyped.textContent = text.slice(index);
      if (index < text.length) {
        setTimeout(type, 20 + Math.random() * 30);
        return;
      }
      caret.remove();
      label.textContent = text;
    };
    setTimeout(type, 300);
  })();
</script>
