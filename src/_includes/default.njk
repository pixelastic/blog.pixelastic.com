<!doctype html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <title>{{ title }} - Pixelastic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#080b09">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/vendor/docsearch.css">
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/atom.xml">
    {% if docsearchExclude %}<meta name="docsearch:exclude" content="true">{% endif %}
  </head>
  <body class="antialiased">
    <div class="reading-shell">
      <header class="reading-header">
        <a class="wordmark" href="/">pixelastic</a>
        <nav>
          <a href="/">Articles</a>
          <a href="/archive/">Archive</a>
          <a href="/tags/">Tags</a>
          <a href="/about/">About</a>
        </nav>
        <div id="search" class="header-search"></div>
      </header>
      {{ content | safe }}
      <footer>
        <div class="footer-links">
          <a href="https://github.com/pixelastic">GitHub</a>
          <a href="/atom.xml">RSS</a>
        </div>
      </footer>
    </div>
    <script src="/vendor/docsearch.js"></script>
    <script>
      docsearch({
        container: '#search',
        appId: '{{ site.docsearch.appId }}',
        apiKey: '{{ site.docsearch.apiKey }}',
        indices: ['{{ site.docsearch.indexName }}'],
      });
    </script>
  </body>
</html>
