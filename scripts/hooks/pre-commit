#!/usr/bin/env sh
# This script *should be* automatically triggered before each git commit.
#
# If it doesn't work, make sure your local git repo is configured to use
# ./scripts/hooks as the base directory for git hooks.
#
# If not, run:
# $ git config core.hooksPath scripts/hooks
set -e

./node_modules/.bin/aberlaas precommit

# Generate the social card of any new or changed post, and add it to the commit.
# Up to date cards are kept, so this is a no-op most of the time. Obsolete
# cards are deleted, `--all` stages those deletions
yarn og
git add --all src/og
