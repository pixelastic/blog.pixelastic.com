---
layout: default.njk
pagination:
  data: collections.archiveList
  size: 1
  alias: period
permalink: "{{ period.url }}"
eleventyComputed:
  title: "{{ period.title }}"
docsearchExclude: true
---
<div class="simple-page">
<h1 class="article-title">{{ period.title }}</h1>
<ul class="simple-list">
  {% for post in period.posts %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
</div>
