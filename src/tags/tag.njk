---
layout: default.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag.slug }}/
eleventyComputed:
  title: "#{{ tag.name }}"
docsearchExclude: true
---
<h1>#{{ tag.name }}</h1>
<ul>
  {% for post in tag.posts %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
