---
layout: default.njk
title: Home
pagination:
  data: collections.postList
  size: 5
  alias: pagePosts
permalink: "{{ '/' if pagination.pageNumber == 0 else '/page' + (pagination.pageNumber + 1) + '/' }}"
---
<section class="article-feed">
  {% for post in pagePosts %}
    <article class="full-article">
      <div class="article-meta">
        <time datetime="{{ post.date.toISOString() | truncate(10, true, '') }}">{{ post.date.toISOString() | truncate(10, true, '') }}</time>
      </div>
      <h1 class="article-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h1>
      <div class="article-content">
        {{ post.content | safe }}
      </div>
      <div class="article-tags">
        {% for tag in post.data.tags %}
          <a href="/tags/{{ tag | tagSlug }}/">#{{ tag }}</a>
        {% endfor %}
      </div>
    </article>
  {% endfor %}
</section>

<nav class="pagination" aria-label="Pagination">
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}">&larr; Older</a>
  {% else %}
    <span class="is-disabled">&larr; Older</span>
  {% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}">Newer &rarr;</a>
  {% else %}
    <span class="is-disabled">Newer &rarr;</span>
  {% endif %}
</nav>
