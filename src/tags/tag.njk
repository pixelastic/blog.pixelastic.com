---
layout: default.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag.slug }}/
eleventyComputed:
  title: "#{{ tag.name }}"
docsearchExclude: true
---
<h1 class="mb-4 text-3xl font-bold">#{{ tag.name }}</h1>
<ul class="list-disc space-y-1 pl-6">
  {% for post in tag.posts %}
    <li><a class="text-blue-700 hover:underline" href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
